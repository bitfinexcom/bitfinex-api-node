    "bfx-api-mock-srv": "^4.0.1",
    "blessed": "0.1.81",
    "brittle": "^4.5.0",
    "cli-table3": "0.6.5",
    "dotenv": "16.6.1",
    "p-iteration": "1.1.8",
    "readline-promise": "1.0.5",
    "socks-proxy-agent": "8.0.5"
  },
  "dependencies": {
    "bfx-api-node-models": "^3.0.0",
    "bfx-api-node-rest": "^9.0.0",
    "bfx-api-node-util": "^2.0.0",
    "bfx-api-node-ws1": "^2.0.0",
    "bignumber.js": "9.3.1",
    "cbq": "^1.0.0",
    "lodash": "^4.18.1",
