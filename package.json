  "description": "Node reference library for Bitfinex API",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "lint": "bfx-lint-js .",
    "lint:fix": "bfx-lint-js . --fix",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "NODE_ENV=test brittle-node --bail 'test/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bitfinexcom/bitfinex-api-node.git"
  },
  "keywords": [
    "bitfinex",
    "bitcoin",
    "BTC"
  ],
